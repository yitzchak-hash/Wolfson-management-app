rules_version = '2';
// The app signs nobody in to Firebase (people sign in with their PIN inside the
// app), so the database must be open to the app's own web key, the setup the
// README describes ("Firestore security rules can remain in test mode").
// Published to the PRACTICE project (wolfson-practice) on 2026-11-04. The
// office's real project keeps whatever rules it has; nothing here touches it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
