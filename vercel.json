{
  "git": {
    "deploymentEnabled": {
      "claude/ui-widget-fixes-fosqdk": false
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/drive-files.js": {
      "maxDuration": 30
    },
    "api/drive-fetch.js": {
      "maxDuration": 60
    },
    "api/geocode.js": {
      "maxDuration": 60
    },
    "api/drive-upload.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/drive-upload?fullBackup=1",
      "schedule": "0 1 * * *"
    }
  ]
}
