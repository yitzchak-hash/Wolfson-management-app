# Paste the entire contents of your service account JSON file as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Random secret — the React app must send this in every request header
# Generate one at: https://generate-secret.vercel.app/32
API_KEY=replace_with_a_random_secret_string

# Your deployed React app URL (no trailing slash) — restricts which origin can call this backend
# Use * during development/testing
ALLOWED_ORIGIN=https://your-app-domain.com

# Railway / Render set PORT automatically — leave this line as-is
PORT=3001
